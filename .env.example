# Sign-in. Secret used to sign the session cookie.
CALLCENTER_SESSION_SECRET=
# Admin access code used until one is set from Settings.
ADMIN_ACCESS_CODE=

# Database for cells, members and follow-ups.
MONGODB_URI=
MONGODB_DB=

# Outreach service that supplies callers and live contact data.
OUTREACH_API=
OUTREACH_API_KEY=

# Landing-page gallery (optional). Without these the gallery rotates bundled photos.
# An API key from a Google Cloud project with the Drive API enabled; restrict it to the Drive API.
GOOGLE_DRIVE_API_KEY=
# Comma-separated Drive folder IDs shared as "anyone with the link". A folder of folders works.
GALLERY_DRIVE_FOLDERS=
